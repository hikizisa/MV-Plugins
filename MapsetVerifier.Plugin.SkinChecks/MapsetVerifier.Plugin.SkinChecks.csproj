<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MapsetVerifier.Plugin.SkinChecks</AssemblyName>
    <HostAssemblyDirectory Condition="'$(HostAssemblyDirectory)' == ''">$(MSBuildProjectDirectory)/../lib</HostAssemblyDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Framework.dll" />
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Parser.dll" />
    <Reference Include="$(HostAssemblyDirectory)/MapsetVerifier.Logging.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <Target Name="CopyToCustomChecks" AfterTargets="Build" Condition="'$(DeployPlugin)' == 'true' and '$(SkipCustomChecksCopy)' != 'true' and '$(APPDATA)' != ''">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(APPDATA)\Mapset Verifier Externals\CustomChecks" />
  </Target>
</Project>
